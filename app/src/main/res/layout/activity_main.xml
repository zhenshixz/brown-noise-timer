<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F4"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="棕噪音定时器"
            android:textColor="#292723"
            android:textSize="27sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="按你的时间，自动播放"
            android:textColor="#817B72"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="播放音频"
                    android:textColor="#746D65"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/fileNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="尚未选择文件"
                    android:textColor="#302B27"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <Button
                android:id="@+id/chooseFileButton"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:minHeight="0dp"
                android:text="更换"
                android:textAllCaps="false"
                android:textColor="#704A36"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="定时规则"
                android:textColor="#302B27"
                android:textSize="19sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/addRuleButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:minHeight="0dp"
                android:text="＋ 添加规则"
                android:textAllCaps="false"
                android:textColor="#704A36"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rulesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="每条规则可单独启停，修改后立即生效。"
            android:textColor="#817B72"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/testButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary"
                android:backgroundTint="#865B40"
                android:minHeight="0dp"
                android:text="现在试听"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
            <Space android:layout_width="10dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:minHeight="0dp"
                android:text="停止播放"
                android:textAllCaps="false"
                android:textColor="#704A36" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="运行状态"
                android:textColor="#302B27"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/scheduleStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已启用 0 条规则"
                android:textColor="#51443A"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/nextStartText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="下次开始 · 暂无"
                android:textColor="#51443A"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/playbackStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="播放状态 · 未播放"
                android:textColor="#51443A"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/permissionStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B34735"
            android:textSize="13sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary"
            android:backgroundTint="#F4EFE8"
            android:minHeight="0dp"
            android:text="允许精确定时"
            android:textAllCaps="false"
            android:textColor="#704A36"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="2dp"
            android:text="只设开始时，会播放到下一条停止规则、手动停止或音频结束。请保持媒体音量合适。"
            android:textColor="#938C82"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
