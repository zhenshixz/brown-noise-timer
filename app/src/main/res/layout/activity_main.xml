<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6F2"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="棕噪音定时器"
            android:textColor="#29231F"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="到点播放，按时安静下来"
            android:textColor="#7A7068"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="让早晨按你的时间开始"
                android:textColor="#3F3025"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="2dp"
                android:text="直接播放手机里的完整音频，无需设置成铃声。锁屏时也能持续播放。"
                android:textColor="#6F5948"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  选择音频"
                android:textColor="#392E27"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="尚未选择文件"
                android:textColor="#756B63"
                android:textSize="14sp" />

            <Button
                android:id="@+id/chooseFileButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:text="从手机文件中选择 MP3"
                android:textAllCaps="false"
                android:textColor="#704A36"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  设置播放时段"
                android:textColor="#392E27"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="开始播放"
                        android:textColor="#756B63"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/startTimeButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_secondary"
                        android:backgroundTint="#F4EFE8"
                        android:text="07:00"
                        android:textAllCaps="false"
                        android:textColor="#392E27"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="停止播放"
                        android:textColor="#756B63"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/stopTimeButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_secondary"
                        android:backgroundTint="#F4EFE8"
                        android:text="10:00"
                        android:textAllCaps="false"
                        android:textColor="#392E27"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/weekdaysCheckBox"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:buttonTint="#90593B"
                android:text="仅周一至周五播放"
                android:textColor="#51443A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="不勾选则每天播放。可设置跨午夜的时段。"
                android:textColor="#8B8178"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary"
            android:backgroundTint="#90593B"
            android:text="保存并开启定时"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/testButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:text="现在试听"
                android:textAllCaps="false"
                android:textColor="#704A36" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:text="停止播放"
                android:textAllCaps="false"
                android:textColor="#704A36" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="运行状态"
                android:textColor="#392E27"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scheduleStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="定时未开启"
                android:textColor="#51443A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/playbackStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="当前未播放"
                android:textColor="#756B63"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permissionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#B34735"
                android:textSize="13sp" />

            <Button
                android:id="@+id/permissionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:text="允许精确定时"
                android:textAllCaps="false"
                android:textColor="#704A36"
                android:visibility="gone" />

            <Button
                android:id="@+id/disableButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary"
                android:backgroundTint="#F4EFE8"
                android:text="暂停每日定时"
                android:textAllCaps="false"
                android:textColor="#704A36"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="2dp"
            android:text="请保持媒体音量合适，并允许应用在后台运行。首次使用建议把开始时间设为两分钟后，锁屏测试一次。"
            android:textColor="#8B8178"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
